# ==============================================================================
# CSRecall Environment Variables
# ==============================================================================

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/csrecall?retryWrites=true&w=majority

# NextAuth Secret & App URL
# Generate a secret via `openssl rand -base64 32`
AUTH_SECRET=your-random-secret-min-32-chars

# Vercel Deployment / Base Application URLs
# NOTE: Keep the Vercel deployment URL configuration separate from email sender configuration.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional: https://console.cloud.google.com)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 1. Nodemailer SMTP Configuration (Account Verification Emails)
# ------------------------------------------------------------------------------
# CSRecall uses Nodemailer to dispatch account verification emails through SMTP.
#
# GMAIL SETUP INSTRUCTIONS:
# - Gmail REQUIRES 2-Step Verification to be turned ON (Google Account -> Security).
# - You MUST generate a 16-character "App Password" (Google Account -> Security -> App passwords).
# - Your normal Gmail account password MUST NOT be used (Google will reject it).
# - In production (e.g. Vercel), SMTP_PASSWORD is a secret and must be configured
#   in Vercel Project Settings -> Environment Variables.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=johnaricsson1@gmail.com
SMTP_PASSWORD=vmwp bxni ceqy djhj
EMAIL_FROM=CSRecall <johnaricsson1@gmail.com>

# ------------------------------------------------------------------------------
# 2. Resend Email Service (Forgot-Password Emails Only)
# ------------------------------------------------------------------------------
# Resend is retained exclusively for forgot-password reset emails.
# Get an API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
